# Cópia de teste: avisa o Google para não indexar (tirar quando virar o site oficial)
/*
  X-Robots-Tag: noindex
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
/imagens/*
  Cache-Control: public, max-age=31536000, immutable
/fontes/*
  Cache-Control: public, max-age=31536000, immutable
/videos/*
  Cache-Control: public, max-age=31536000, immutable
